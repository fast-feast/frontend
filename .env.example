[TEMPLATE]
VITE_GEMINI_API_KEY=your_gemini_api_key
VITE_GEMINI_MODEL=gemini-2.5-flash

# ─── Firebase Web SDK (STUDENTS ONLY — public values, safe for browser) ──
# From Firebase console → Project settings → General → Your apps → Web app → SDK setup and configuration.
# Providers used: Google + Email/Password (NO phone/SMS authentication).
# Placeholders: fill in before student login will work. Owners/admins do NOT need these.
VITE_FIREBASE_API_KEY=your_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_web_app_id
